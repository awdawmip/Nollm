    {
      "key": "snapshot.scope",
      "text": "SnapshotService copies the bytes exported by the supplied port and verifies by byte equality. A Core-only port therefore does not back up the separately stored statement files or handle bindings.",
      "reviewed_commit": "8a29bb509c972897c4b5d59a901715be23be604f",
