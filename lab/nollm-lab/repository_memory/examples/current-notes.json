    {
      "key": "statement.retry",
      "text": "Retrying a write with the same statement ID and identical content leaves the stored statement intact. Reusing that ID with different content raises FileExistsError, so publish a revision under a new statement identity.",
      "reviewed_commit": "314eb47490adcad22e37d6e05d2da3983e78956d",
      "evidence": [
        {
          "path": "packages/nollm-access/src/nollm_access/statement_store.py",
