    {
      "key": "binding.current",
      "text": "Attaching a second statement to an occupied handle preserves the current statement and records the newcomer as supporting evidence. Replacing the current statement is a separate revision operation.",
      "reviewed_commit": "8a29bb509c972897c4b5d59a901715be23be604f",
      "evidence": [
        {
          "path": "packages/nollm-access/src/nollm_access/handle_store.py",
