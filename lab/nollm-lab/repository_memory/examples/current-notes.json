          "blob": "866761ffbc96970473e98e120d0e15c3a65bd920"
        }
      ]
    },
    {
      "key": "statement.shape",
      "text": "A Nollm memory statement carries an ID, meaningful text, an optional source handle, and zero or more context references. Its persisted mapping has exactly those four fields; a host can cite a Git source without changing Core.",
      "reviewed_commit": "314eb47490adcad22e37d6e05d2da3983e78956d",
      "evidence": [
