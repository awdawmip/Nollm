{
  // 1. Install/enable this package as a companion tool plugin.
  plugins: {
    entries: {
      "nollm-memory-companion": {
        enabled: true,
        config: {
          pythonCommand: "python3",
          nollmRepoRoot: "C:/absolute/path/to/nollm",
          workspaceRoot: "C:/absolute/path/to/openclaw-workspace",
          // Optional; must resolve under nollmRepoRoot.
          sidecarScript: "C:/absolute/path/to/nollm/reference/python/scripts/run_openclaw_nollm_memory.py",
          // Optional; must resolve under workspaceRoot.
          sidecarOutDir: "C:/absolute/path/to/openclaw-workspace/.nollm-memory",
          commandTimeoutMs: 15000,
          maxSearchResults: 5
        }
      }
    }
  },

  // 2. Tool policy: allow read companion tools and explicitly opt into pending writes.
  tools: {
    allow: [
      "memory_search",
      "memory_get",
      "nollm_memory_search",
      "nollm_memory_get",
      "nollm_memory_status"
    ],
    optionalAllow: [
      "nollm_memory_write_candidate"
    ]
  },

  // 3. Optional Active Memory experiment guidance:
  // If an operator explicitly opts into an Active Memory experiment, combine
  // memory_search, memory_get, nollm_memory_search, and nollm_memory_get in
  // that experiment's documented tool policy. Prompt the recall sub-agent that
  // Nollm gravity reports annotate drift and do not replace source verification.
}
