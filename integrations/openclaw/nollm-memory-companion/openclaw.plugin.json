{
  "id": "nollm-memory-companion",
  "name": "Nollm Memory Companion",
  "description": "Companion tools that delegate to the Nollm Python sidecar while OpenClaw memory-core remains the active owner.",
  "version": "0.1.0",
  "skills": [
    "skill"
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "pythonCommand": {
        "type": "string",
        "default": "python"
      },
      "nollmRepoRoot": {
        "type": "string",
        "description": "Optional at install time; required absolute path to the Nollm repository before tool use."
      },
      "workspaceRoot": {
        "type": "string",
        "description": "Optional at install time; required absolute path to the OpenClaw workspace before tool use."
      },
      "sidecarScript": {
        "type": "string",
        "description": "Optional absolute path under nollmRepoRoot."
      },
      "sidecarOutDir": {
        "type": "string",
        "description": "Optional absolute path under workspaceRoot."
      },
      "commandTimeoutMs": {
        "type": "integer",
        "default": 15000,
        "minimum": 1000,
        "maximum": 60000
      },
      "maxSearchResults": {
        "type": "integer",
        "default": 5,
        "minimum": 1,
        "maximum": 20
      }
    },
    "additionalProperties": false
  },
  "activation": {
    "onStartup": false
  },
  "extensions": [
    {
      "id": "nollm-memory-companion",
      "entry": "./dist/index.js"
    }
  ],
  "contracts": {
    "tools": [
      "nollm_memory_status",
      "nollm_field_overview",
      "nollm_open_well",
      "nollm_surface",
      "nollm_focus",
      "nollm_drift",
      "nollm_read",
      "nollm_recall_trace"
    ]
  }
}
