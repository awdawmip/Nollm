{
  "name": "@nollm/openclaw-formation-loop",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "scripts"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": "2026.6.11",
      "minGatewayVersion": "2026.6.11"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "plugin:check": "npm run build && node -e \"import('./dist/index.js').then(m=>{if(typeof m.default?.register!=='function')process.exit(1)})\""
  },
  "peerDependencies": {
    "openclaw": ">=2026.6.11"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "dependencies": {
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openclaw": "^2026.6.11",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24"
  }
}
