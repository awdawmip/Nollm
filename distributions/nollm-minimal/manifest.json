{
  "name": "nollm-minimal",
  "runtime": ["nollm-core", "nollm-snapshot", "nollm-access"],
  "entrypoint": "nollm_access.AccessRuntime",
  "defaults": [
    "nollm_access.FileEvidenceStore",
    "nollm_access.FileHandleStore",
    "nollm_snapshot.SnapshotService",
    "trace=None"
  ],
  "forbidden": ["legacy-grf", "openclaw-live"]
}
