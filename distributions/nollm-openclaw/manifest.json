{
  "name": "nollm-openclaw",
  "extends": "nollm-minimal",
  "adapter": "integrations/openclaw/formation-loop",
  "live_activation": "invisible-dream-agent",
  "validation_gate": "openclaw:dream-agent-live",
  "surfaceWire": "nollm_openclaw_bounded_approximate_surface_traversal_v1",
  "geometryProfile": "default_dream_v1",
  "geometryContractVersion": "nollm_bounded_approximate_hex_coverage_v1",
  "coveragePolicyVersion": "nollm_broad_residue_min_hit_1_v1",
  "writableFieldContractVersion": "nollm_hex_storage_2p31_writable_2p30_depth2_v1",
  "revisionConfirmationWire": "nollm_openclaw_revision_confirmation_v1",
  "revisionConfirmationMaxCalls": 1,
  "revisionRedecisionMaxCalls": 1,
  "propositionWriterWire": "nollm_openclaw_content_neutral_proposition_writer_v4",
  "fieldCartographerWire": "nollm_openclaw_field_cartographer_v2",
  "progressiveAtlasPageWire": "nollm_access_progressive_atlas_page_v2",
  "localDetailPageWire": "nollm_access_local_detail_page_v1",
  "fastRecallWire": "nollm_openclaw_single_call_entry_recall_v1",
  "mainAgentRecallWire": "nollm_openclaw_main_agent_geometry_recall_v2",
  "mainAgentRecallTool": "nollm_memory",
  "captureAbsorptionDirectiveWire": "nollm_openclaw_capture_absorption_directive_v2",
  "toolEvidenceWire": "nollm_openclaw_tool_evidence_v1",
  "captureStateWire": "nollm_openclaw_capture_state_event_v2",
  "contentEligibilityPolicy": "content-neutral",
  "sensitiveClassifier": false,
  "writerSourceWindowBytes": 12000,
  "writerSourceGroupBytes": 32000,
  "writerSourceOverlapCodepoints": 128,
  "writerMaxStatementsPerPass": 8,
  "legacySemanticStateMigration": true,
  "activeSemanticPipeline": ["content-neutral-proposition-writer-v4", "field-cartographer-v2", "access-apply"],
  "legacyFormationPublicApi": "none",
  "memoryScopeMode": "single-configured-scope",
  "routingSurfaceOnly": true,
  "routingSurfaceMaxBytes": 8192,
  "routingTextMaxChars": 3000,
  "defaultProfile": "shadow-observation",
  "profiles": {
    "shadow-observation": {"writeMode": "shadow", "admission": false},
    "active-memory": {"writeMode": "statement-store", "admission": true, "workspaceRequired": true}
  },
  "legacyReader": false,
  "defaultLocalityMaxResults": 4,
  "defaultLocalityMaxChars": 3000,
  "cartographerMaxRegions": 32,
  "cartographerMaxPromptBytes": 65536,
  "cartographerMaxTurns": 4,
  "evidenceFilenameContract": "run_scoped_live_then_immutable_freeze_v1",
  "writePhysicalLayer": 0,
  "dreamAgent": {
    "enabled": true,
    "mode": "background",
    "modelMode": "inherit",
    "persistTranscripts": false,
    "profile": "shadow-observation",
    "writeMode": "shadow"
  },
  "formationTool": {"visible": false},
  "recallTool": {"mainAgentInternal": true, "actions": ["surface", "open_region", "recall", "expand", "none"], "singleEntry": true, "serverIssuedOperation": true, "runScoped": true},
  "externalApi": {"required": false},
  "requires": ["nollm-access", "openclaw>=2026.6.11", "statement-store"],
  "diagnose": "integrations/openclaw/formation-loop/scripts/diagnose.ps1",
  "forbidden": ["legacy-grf-runtime-entrypoint", "direct-core-import", "multi-entry-recall", "python-semantic-fallback"]
}
