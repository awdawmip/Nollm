{"schema_version":"nollm_access_statement_v1","statement":{"content_utf8":"相遇默认读取，准备新位置才枚举写格，压力按需计算。后继Host可在同一现场提炼、修订和搬移；容量按整批最终布局检查，改变的当前表达与指定旧路径须能从实际入口向下读回。","context_refs":["revises:nollm.formed.-1.encounter-use.v1"],"source_handle":"211ed1f2bf734ffb7daf0e5c7704e9da1a9ded01:docs/project/NOLLM_LOCAL_REORGANIZATION_AND_STORAGE_20261124.md#L22-L88","statement_id":"nollm.formed.-1.encounter-use.v2"}}
