{"schema_version":"nollm_access_statement_v1","statement":{"content_utf8":"局部批次按最终容量提交并保留已捕获表达。条件写只有确定未提交或已回滚时才清理本次新增原文；提交状态不明时保留原文与恢复记录，下次Access打开恢复布局。独立Core读者无跨文件瞬时事务保证。","context_refs":["a30dafca126b2b533ee86868cab10d1bc7e5e51a:packages/nollm-access/src/nollm_access/runtime.py#L312-L376","a30dafca126b2b533ee86868cab10d1bc7e5e51a:packages/nollm-access/tests/test_reorganization.py#L256-L310","revises:nollm.formed.-1.versions-commit.v2"],"source_handle":"a30dafca126b2b533ee86868cab10d1bc7e5e51a:docs/project/NOLLM_PORTABLE_DEPLOYMENT_20261125.md#L26-L46","statement_id":"nollm.formed.-1.versions-commit.v3"}}
